# PostgreSQL (e.g. Supabase). URL-encode special chars in the password (@ -> %40).
# For the Supabase pooler (port 6543) keep ?pgbouncer=true.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — use for `prisma db push` / migrations, NOT for runtime:
# DIRECT_URL="postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres"
SESSION_SECRET="change-me-to-a-long-random-string-min-32-chars"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin123!"
SITE_NAME="Projects"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
